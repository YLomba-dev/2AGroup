      "id": "b1d5f8e0-0004-4a00-9000-000000000004",
      "name": "Build package (forms, cover letter, exhibits, one PDF)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { built: true, caseId: $json.caseId, version: $json.package.version, pages: $json.package.pageCount, status: 'Draft waiting for attorney approval in the dashboard' } }}",
        "options": {}
      },
      "id": "b1d5f8e0-0005-4a00-9000-000000000005",
      "name": "Reply: built",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        960,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Turn missing items into a plain-language message for the client.\nconst v = $input.first().json;\n// Staff-only items (for example country conditions research) are never sent to the client.\nconst docs = v.missingDocuments.filter(d => !d.staffOnly).map(d => '- ' + d.label);\nconst answers = v.missingAnswers.length ? ['- ' + v.missingAnswers.length + ' question(s) in \"My information\"'] : [];\nconst text = ['Hello! To prepare your filing we still need:', ...docs, ...answers, 'You can upload documents and answer questions in your portal. Thank you!'].join('\\n');\nreturn [{ json: { caseId: v.caseId, text, missingDocuments: v.missingDocuments, missingAnswers: v.missingAnswers, errors: v.errors } }];"
      },
      "id": "b1d5f8e0-0006-4a00-9000-000000000006",
      "name": "Write missing-items message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=__API_BASE__/api/automation/cases/{{ $json.caseId }}/message",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-automation-key",
              "value": "__AUTOMATION_KEY__"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { text: $json.text, kind: 'missing-items' } }}",
        "options": {}
      },
      "id": "b1d5f8e0-0007-4a00-9000-000000000007",
      "name": "Message client in portal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        420
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { built: false, caseId: $('Write missing-items message').item.json.caseId, errors: $('Write missing-items message').item.json.errors, missingDocuments: $('Write missing-items message').item.json.missingDocuments } }}",
        "options": {}
      },
      "id": "b1d5f8e0-0008-4a00-9000-000000000008",
      "name": "Reply: not ready",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        420
      ]
    }
