{
  "name": "2a-petition-platform",
  "version": "0.1.0",
  "private": true,
  "description": "2A Group Corp demo: client portal, staff dashboard and petition assembly service for USCIS filings",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "db:start": "supabase start -x edge-runtime,imgproxy,supavisor,vector,logflare",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "setup": "node scripts/setup.js",
    "seed": "node scripts/seed.js",
    "n8n:import": "node scripts/n8n-import.js",
    "n8n:build": "node scripts/build-workflows.js",
    "inspect-form": "node scripts/inspect-form.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "multer": "^1.4.4",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "supabase": "^2.122.0"
  }
}
